{
  "name": "claudedeck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck plugin for Claude Code: approve permission prompts and watch session status from your Stream Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"npm run reload\"",
    "test": "vitest run",
    "test:module": "node scripts/test-module.mjs",
    "module:install": "tsx src/installer/cli.ts install",
    "module:remove": "tsx src/installer/cli.ts remove",
    "link": "streamdeck link com.claudedeck.streamdeck.sdPlugin",
    "reload": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -like '*com.claudedeck.streamdeck.sdPlugin*plugin.js*' } | ForEach-Object { Stop-Process -Id $_.ProcessId }\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^24.19.1",
    "rollup": "^4.64.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
